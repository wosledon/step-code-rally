{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@step-harness/coding-agent": ["./node_modules/@earendil-works/pi-coding-agent/dist/index.js"],
      "@step-harness/pi-tui": ["./node_modules/@earendil-works/pi-tui/dist/index.js"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "*.ts"]
}
